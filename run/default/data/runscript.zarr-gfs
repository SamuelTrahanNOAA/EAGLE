#!/bin/bash

#SBATCH --account=gsd-fv3
#SBATCH --export=NONE
#SBATCH --mem-per-cpu=3G
#SBATCH --ntasks=4
#SBATCH --output=runscript.zarr-gfs.out
#SBATCH --partition=u1-service
#SBATCH --time=00:10:00

source /etc/profile.d/profile-slurm.sh
source ../../../conda/etc/profile.d/conda.sh
conda activate data
set -ex

time srun --export=ALL ufs2arco ufs2arco-gfs.yaml --overwrite
test $? -eq 0 && touch runscript.zarr-gfs.done
